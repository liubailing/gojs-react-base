### 2. Mock 数据生成
```typescript
// tests/helpers/mock-generator.ts
import { faker } from '@faker-js/faker';

export class MockDataGenerator {
  static generateWorkflow() {
    return {
      id: faker.string.uuid(),
      name: faker.lorem.words(3),
      description: faker.lorem.sentence(),
      steps: this.generateSteps(faker.number.int({ min: 3, max: 10 }))
    };
  }

  static generateSteps(count: number) {
    return Array(count).fill(0).map(() => ({
      id: faker.string.uuid(),
      type: faker.helpers.arrayElement(['navigate', 'click', 'extract']),
      config: this.generateStepConfig()
    }));
  }

  private static generateStepConfig() {
    return {
      selector: faker.internet.domainName(),
      timeout: faker.number.int({ min: 1000, max: 10000 })
    };
  }
}
```

## 持续集成测试

### 1. CI/CD 测试流水线
```yaml
# .github/workflows/test.yml
name: 测试流水线

on: [push, pull_request]

jobs:
  unit-tests:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      - uses: actions/setup-node@v3
        with:
          node-version: 18
      - run: pnpm install
      - run: pnpm test
      - run: pnpm test:coverage

  integration-tests:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:14
        env:
          POSTGRES_PASSWORD: test
    steps:
      - uses: actions/checkout@v3
      - run: pnpm install
      - run: pnpm test:integration

  e2e-tests:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      - run: pnpm install
      - run: pnpm build
      - run: pnpm test:e2e
```

### 2. 测试报告
```bash
# 生成测试报告
pnpm test:coverage
pnpm test:e2e --reporter=html

# 上传覆盖率报告
pnpm coverage:upload
```

## 测试最佳实践

### 1. 编写原则
- **AAA 模式**: Arrange, Act, Assert
- **单一断言**: 每个测试只验证一个行为
- **独立性**: 测试之间不应相互依赖
- **可重复**: 测试结果应该一致

### 2. 命名约定
```typescript
// ✅ 好的测试命名
describe('WorkflowRunner', () => {
  describe('execute', () => {
    it('应该在配置有效时成功执行工作流', async () => {
      // 测试实现
    });

    it('应该在步骤失败时返回错误信息', async () => {
      // 测试实现
    });
  });
});
```

### 3. Mock 策略
```typescript
// ✅ 合适的 Mock 使用
import { vi } from 'vitest';

// Mock 外部依赖
vi.mock('puppeteer', () => ({
  launch: vi.fn().mockResolvedValue({
    newPage: vi.fn().mockResolvedValue({
      goto: vi.fn(),
      click: vi.fn()
    })
  })
}));

// Mock 内部模块
vi.mock('../utils/logger', () => ({
  log: vi.fn(),
  error: vi.fn()
}));
```

### 4. 测试维护
- **定期重构**: 重构代码时同步更新测试
- **清理过时测试**: 删除无效或重复的测试
- **文档化**: 为复杂测试添加说明注释
- **代码审查**: 测试代码也需要进行代码审查

## 故障排除

### 1. 常见问题
```bash
# 测试超时
# 解决方案: 增加超时时间或优化测试性能

# 内存泄漏
# 解决方案: 正确清理资源，使用 afterEach

# 不稳定测试
# 解决方案: 移除时间依赖，使用确定性数据
```

### 2. 调试技巧
```typescript
// 调试测试
import { debug } from 'vitest';

test('调试示例', async () => {
  const result = await someAsyncFunction();
  
  // 调试输出
  debug(result);
  
  // 条件断点
  if (result.status !== 'success') {
    debugger;
  }
  
  expect(result.status).toBe('success');
});
```
