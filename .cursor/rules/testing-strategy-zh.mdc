# 测试策略指南

## 测试架构概览

八爪鱼数据采集器项目采用多层次测试策略，确保代码质量和系统稳定性。测试覆盖从单元测试到端到端集成测试的完整链路。

## 测试层次结构

### 1. 测试金字塔
```
    E2E Tests (端到端测试)
      ↑ 少量，高价值
  ══════════════════════
    Integration Tests (集成测试)
      ↑ 适量，关键路径
  ══════════════════════════════
      Unit Tests (单元测试)
        ↑ 大量，快速反馈
```

### 2. 测试类型分布
- **单元测试**: 80% - 快速、独立、覆盖面广
- **集成测试**: 15% - 验证组件协作
- **端到端测试**: 5% - 验证用户流程

## 单元测试 (Unit Tests)

### 1. 工具栈
- **框架**: [Vitest](mdc:https:/vitest.dev) (配置在 [apps/octoparse/vitest.config.ts](mdc:apps/octoparse/vitest.config.ts))
- **断言**: Vitest 内置断言
- **模拟**: vi.mock(), vi.fn()
- **覆盖率**: c8/v8

### 2. 测试文件结构
```
packages/workflow/
├── src/
│   ├── actions/
│   │   ├── click.ts
│   │   └── __tests__/
│   │       └── click.test.ts
│   ├── utils/
│   │   ├── common.ts
│   │   └── __tests__/
│   │       └── common.test.ts
└── tests/
    ├── setup.ts
    └── helpers/
```

### 3. 单元测试示例
```typescript
// packages/workflow/src/utils/__tests__/common.test.ts
import { describe, it, expect, vi } from 'vitest';
import { createId, validateConfig } from '../common';

describe('Common Utils', () => {
  describe('createId', () => {
    it('应该生成唯一的 ID', () => {
      const id1 = createId();
      const id2 = createId();
      
      expect(id1).toMatch(/^wf_\d+_\d+/);
      expect(id1).not.toBe(id2);
    });
  });

  describe('validateConfig', () => {
    it('应该验证有效配置', () => {
      const validConfig = {
        id: 'test-id',
        name: 'Test Workflow',
        steps: []
      };
      
      expect(validateConfig(validConfig)).toBe(true);
    });

    it('应该拒绝无效配置', () => {
      const invalidConfig = { name: 'Test' };
      
      expect(validateConfig(invalidConfig)).toBe(false);
    });
  });
});
```

### 4. 测试命令
```bash
# 运行所有单元测试
pnpm test

# 运行特定包的测试
pnpm --filter workflow test

# 监听模式
pnpm --filter workflow test --watch

# 覆盖率报告
pnpm --filter workflow test --coverage
```

## 集成测试 (Integration Tests)

### 1. 测试目标
- 包之间的交互
- 数据库集成
- 外部 API 调用
- 文件系统操作

### 2. 集成测试示例
```typescript
// packages/runner/tests/integration/workflow-runner.test.ts
import { describe, it, expect, beforeEach, afterEach } from 'vitest';
import { WorkflowRunner } from '../src/runner';
import { MockWorkflow } from './mocks/workflow';

describe('WorkflowRunner Integration', () => {
  let runner: WorkflowRunner;
  let mockWorkflow: MockWorkflow;

  beforeEach(() => {
    mockWorkflow = new MockWorkflow();
    runner = new WorkflowRunner(mockWorkflow);
  });

  afterEach(async () => {
    await runner.cleanup();
  });

  it('应该成功执行简单工作流', async () => {
    const config = {
      id: 'test-workflow',
      name: 'Test Workflow',
      steps: [
        { type: 'navigate', url: 'https://example.com' },
        { type: 'click', selector: '#button' }
      ]
    };

    const result = await runner.execute(config);

    expect(result.success).toBe(true);
    expect(result.steps).toHaveLength(2);
    expect(mockWorkflow.getExecutedSteps()).toEqual(['navigate', 'click']);
  });

  it('应该处理执行错误', async () => {
    const config = {
      id: 'failing-workflow',
      name: 'Failing Workflow',
      steps: [
        { type: 'invalid-action' }
      ]
    };

    const result = await runner.execute(config);

    expect(result.success).toBe(false);
    expect(result.error).toBeDefined();
  });
});
```

### 3. 数据库集成测试
```typescript
// packages/runner/tests/integration/database.test.ts
import { describe, it, expect, beforeAll, afterAll } from 'vitest';
import { DatabaseManager } from '../src/database';
import { TestDatabase } from './helpers/test-database';

describe('Database Integration', () => {
  let db: DatabaseManager;
  let testDb: TestDatabase;

  beforeAll(async () => {
    testDb = new TestDatabase();
    await testDb.setup();
    db = new DatabaseManager(testDb.getConnectionString());
  });

  afterAll(async () => {
    await testDb.teardown();
  });

  it('应该保存和检索工作流结果', async () => {
    const result = {
      workflowId: 'test-wf-1',
      status: 'completed',
      data: { count: 10 }
    };

    await db.saveResult(result);
    const retrieved = await db.getResult('test-wf-1');

    expect(retrieved).toEqual(result);
  });
});
```

## 端到端测试 (E2E Tests)

### 1. 工具栈
- **框架**: Playwright
- **应用**: Electron 应用测试
- **环境**: 隔离的测试环境

### 2. E2E 测试结构
```
apps/octoparse/tests/e2e/
├── fixtures/
│   ├── test-workflows/
│   └── mock-data/
├── pages/
│   ├── home.page.ts
│   ├── settings.page.ts
│   └── workflow.page.ts
├── specs/
│   ├── workflow-creation.spec.ts
│   ├── data-extraction.spec.ts
│   └── settings.spec.ts
└── helpers/
    ├── app-launcher.ts
    └── test-data.ts
```

### 3. E2E 测试示例
```typescript
// apps/octoparse/tests/e2e/specs/workflow-creation.spec.ts
import { test, expect } from '@playwright/test';
import { AppLauncher } from '../helpers/app-launcher';
import { HomePage } from '../pages/home.page';
import { WorkflowPage } from '../pages/workflow.page';

test.describe('工作流创建', () => {
  let app: AppLauncher;
  let homePage: HomePage;
  let workflowPage: WorkflowPage;

  test.beforeEach(async () => {
    app = new AppLauncher();
    await app.launch();
    homePage = new HomePage(app.page);
    workflowPage = new WorkflowPage(app.page);
  });

  test.afterEach(async () => {
    await app.close();
  });

  test('应该创建新的工作流', async () => {
    await homePage.clickCreateWorkflow();
    await workflowPage.setWorkflowName('测试工作流');
    await workflowPage.addStep('navigate', { url: 'https://example.com' });
    await workflowPage.addStep('extract', { selector: '.content' });
    await workflowPage.save();

    await expect(workflowPage.getSuccessMessage()).toBeVisible();
    
    const workflows = await homePage.getWorkflowList();
    expect(workflows).toContain('测试工作流');
  });

  test('应该执行工作流并显示结果', async () => {
    await homePage.selectWorkflow('测试工作流');
    await workflowPage.run();

    await expect(workflowPage.getExecutionStatus()).toHaveText('运行中');
    await workflowPage.waitForCompletion();
    await expect(workflowPage.getExecutionStatus()).toHaveText('已完成');

    const results = await workflowPage.getResults();
    expect(results.length).toBeGreaterThan(0);
  });
});
```

## 性能测试

### 1. 性能基准测试
```typescript
// packages/workflow/tests/performance/benchmark.test.ts
import { describe, it, expect } from 'vitest';
import { performance } from 'perf_hooks';
import { WorkflowEngine } from '../src/engine';

describe('性能基准测试', () => {
  it('应该在合理时间内处理大量步骤', async () => {
    const engine = new WorkflowEngine();
    const steps = Array(1000).fill(0).map((_, i) => ({
      id: `step-${i}`,
      type: 'extract',
      selector: `.item-${i}`
    }));

    const startTime = performance.now();
    await engine.processSteps(steps);
    const endTime = performance.now();

    const executionTime = endTime - startTime;
    expect(executionTime).toBeLessThan(5000); // 5秒内完成
  });

  it('应该在内存限制内运行', async () => {
    const initialMemory = process.memoryUsage().heapUsed;
    
    const engine = new WorkflowEngine();
    await engine.processLargeDataset();
    
    const finalMemory = process.memoryUsage().heapUsed;
    const memoryIncrease = finalMemory - initialMemory;
    
    expect(memoryIncrease).toBeLessThan(100 * 1024 * 1024); // 100MB 限制
  });
});
```

